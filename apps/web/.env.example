# API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Secret-gated QA auth smoke signup. Keep disabled unless a controlled
# production QA path is needed. Uses Supabase Admin to create confirmed users
# without sending signup email.
AUTH_SMOKE_SIGNUP_ENABLED=false
AUTH_SMOKE_SIGNUP_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth (get from Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# GitHub App (slug from github.com/apps/<slug>)
NEXT_PUBLIC_GITHUB_APP_NAME=your-github-app-name
